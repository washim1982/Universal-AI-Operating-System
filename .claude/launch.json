{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aios-dev",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "aios.cli.main",
        "dev",
        "--app",
        "apps/ai-researcher",
        "--app",
        "tests/fixtures/apps/refund-desk",
        "--app",
        "tests/fixtures/apps/people-desk",
        "--cassettes",
        "tests/cassettes/ai-researcher",
        "--port",
        "18080"
      ],
      "port": 18080,
      "url": "http://127.0.0.1:18080"
    },
    {
      "name": "console",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd console && set AIOS_SERVER=http://127.0.0.1:18080&& set CONSOLE_URL=http://127.0.0.1:3010&& npx next dev --port 3010"
      ],
      "port": 3010,
      "url": "http://127.0.0.1:3010"
    },
    {
      "name": "docs",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": [
        "-m",
        "mkdocs",
        "serve",
        "--dev-addr",
        "127.0.0.1:8010",
        "--no-livereload"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010"
    }
  ]
}
