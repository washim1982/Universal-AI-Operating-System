# Where the AIOS API is. The console calls it from the server, so a browser never needs to reach it.
AIOS_SERVER=http://127.0.0.1:18080

# This console's own address. Sign-in redirects are built from it. https makes the cookie Secure.
CONSOLE_URL=http://127.0.0.1:3000

# Seals the session cookie: at least 32 characters. Required in production. In development a new one
# is made each time the server starts, which signs everybody out.
# CONSOLE_SESSION_SECRET=XXXXXX

# Sign in through an identity provider. Leave these out to sign in with an API key instead.
# OIDC_ISSUER=http://127.0.0.1:18180/realms/aios
# OIDC_CLIENT_ID=aios-console
# OIDC_CLIENT_SECRET=XXXXXX
