# Copy to deploy/compose/.env to override the development defaults. .env is git-ignored.
AIOS_PG_USER=aios
AIOS_PG_PASSWORD=XXXXXX
AIOS_PG_DB=aios

# Host ports (all bound to 127.0.0.1). Change them if another stack already uses the defaults.
AIOS_PG_PORT=5432
AIOS_OTLP_GRPC_PORT=4317
AIOS_OTLP_HTTP_PORT=4318
AIOS_JAEGER_UI_PORT=16686

# Tell another system what needs deciding. Requests are signed with the secret, and carry no
# payload: the receiver fetches that through the API. Set both on the worker, not here: Compose
# doesn't run AIOS itself.
# AIOS_APPROVAL_WEBHOOK_URL=https://chat.example/aios/approvals
# AIOS_APPROVAL_WEBHOOK_SECRET=XXXXXX

# Which injection classifier reads what agents read: heuristic (the default), none, or
# module:attribute for your own. It only ever raises a flag. Set it on the worker and the API.
# AIOS_INJECTION_CLASSIFIER=heuristic

# Your own models and prices: a YAML file in the form of src/aios/models/defaults/registry.yaml,
# whose entries add to the shipped ones or replace them by id. Fill in a <placeholder> model this
# way, or price a private one so that budgets count it. Set it on the worker.
# AIOS_MODEL_REGISTRY=/etc/aios/registry.yaml

# More tools: comma-separated module:attribute, each a function that returns tool providers.
# The AI Support Desk's stand-ins for Stripe and Zendesk are ai_support_desk.tools:providers.
# Set it on the worker.
# AIOS_TOOL_PROVIDERS=ai_support_desk.tools:providers

# Keys for model providers, read by each provider's own SDK. Set them on the worker.
# ANTHROPIC_API_KEY=XXXXXX
# OPENAI_API_KEY=XXXXXX
# GOOGLE_API_KEY=XXXXXX

# The optional console profile. See console/README.md.
AIOS_CONSOLE_PORT=3000
# CONSOLE_SESSION_SECRET=XXXXXX

# The optional registry profile, for `aios app push` and `aios app pull`. Anything that speaks the
# OCI Distribution API will do; a registry that asks for a password gets these two.
AIOS_REGISTRY_PORT=5000
# AIOS_REGISTRY_USERNAME=XXXXXX
# AIOS_REGISTRY_PASSWORD=XXXXXX

# Where a process unpacks the code of installed Apps. Default: .aios/apps in its working folder.
# AIOS_APP_CACHE=/var/lib/aios/apps

# Which provider serves a tool, if two offer it: tool=provider here, tenant/tool=provider for one.
# AIOS_TOOL_BINDINGS=filesystem.file.read=archive,acme/mail.send=sandbox-mail

# The optional security profile: Keycloak and OpenBao.
AIOS_KEYCLOAK_PORT=8180
AIOS_KEYCLOAK_PASSWORD=XXXXXX
AIOS_VAULT_PORT=8200
AIOS_VAULT_TOKEN=XXXXXX
