# Copy to deploy/compose/.env to override the development defaults. .env is git-ignored.
AIOS_PG_USER=aios
AIOS_PG_PASSWORD=XXXXXX
AIOS_PG_DB=aios

# Host ports (all bound to 127.0.0.1). Change them if another stack already uses the defaults.
AIOS_PG_PORT=5432
AIOS_OTLP_GRPC_PORT=4317
AIOS_OTLP_HTTP_PORT=4318
AIOS_JAEGER_UI_PORT=16686
