// AIOS Cedar schema v0.2 (ADR-007, ADR-011). Compiled policies are validated against it.
// Generated by `aios specs export` from src/aios/security/cedar_schema.py. Do not edit.
entity Tenant;
entity Role in [Tenant];
entity App in [Tenant];
entity Agent in [App, Role, Tenant];
entity User in [Role, Tenant];
entity Service in [Role, Tenant];
entity System;
entity Tool = {
  name: String,
  provider: String,
  object: String,
  verb: String,
  sideEffect: String
};
entity MemoryScope;

// Each compiled policy set declares the tool-input fields its conditions reference.
type ToolInput = {};
type ToolContext = { tainted: Bool, approved: Bool, input: ToolInput };
type BaseContext = { tainted: Bool, approved: Bool };

action "tool.invoke" appliesTo {
  principal: [Agent, User, App, Service, System],
  resource: [Tool],
  context: ToolContext
};
action "memory.read", "memory.write" appliesTo {
  principal: [Agent, User, App, Service, System],
  resource: [MemoryScope],
  context: BaseContext
};
action "model.route", "task.dispatch" appliesTo {
  principal: [Agent],
  resource: [Tenant],
  context: BaseContext
};
action "app.install", "app.manage", "app.read", "approval.decide", "approval.read", "audit.read", "dlq.manage", "eval.grade", "eval.read", "eval.run", "event.read", "key.manage", "memory.manage", "metrics.read", "run.control", "run.feedback", "run.read", "run.start", "security.suspend", "task.work" appliesTo {
  principal: [User, Service],
  resource: [Tenant],
  context: BaseContext
};
