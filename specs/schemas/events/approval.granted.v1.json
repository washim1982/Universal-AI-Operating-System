{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/approval.granted/1",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Approval",
      "type": "string"
    },
    "by": {
      "pattern": "^(user|agent|app|service|system):[A-Za-z0-9._~-]+(@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)?$",
      "title": "By",
      "type": "string"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "voters": {
      "description": "With a quorum: everyone whose yes it took",
      "items": {
        "pattern": "^(user|agent|app|service|system):[A-Za-z0-9._~-]+(@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)?$",
        "type": "string"
      },
      "title": "Voters",
      "type": "array"
    },
    "edits": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What the approver changed (FR-HUM-06)",
      "title": "Edits"
    },
    "payload": {
      "$ref": "#/$defs/JsonValue",
      "default": null,
      "description": "With edits: the action as approved"
    },
    "via": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Answered with a signed link sent by slack, teams or email",
      "title": "Via"
    }
  },
  "required": [
    "approval",
    "by"
  ],
  "title": "approval.granted v1 payload",
  "type": "object"
}
