{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/approval.modified/1",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "The approver changed the action before saying yes (FR-HUM-06).",
  "properties": {
    "approval": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Approval",
      "type": "string"
    },
    "by": {
      "pattern": "^(user|agent|app|service|system):[A-Za-z0-9._~-]+(@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)?$",
      "title": "By",
      "type": "string"
    },
    "edits": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Edits",
      "type": "object"
    },
    "payload": {
      "$ref": "#/$defs/JsonValue"
    }
  },
  "required": [
    "approval",
    "by",
    "edits",
    "payload"
  ],
  "title": "approval.modified v1 payload",
  "type": "object"
}
