{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/approval.voted/1",
  "additionalProperties": false,
  "description": "One yes of the several a quorum needs (FR-HUM-04).",
  "properties": {
    "approval": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Approval",
      "type": "string"
    },
    "by": {
      "pattern": "^(user|agent|app|service|system):[A-Za-z0-9._~-]+(@[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)?$",
      "title": "By",
      "type": "string"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comment"
    },
    "votes": {
      "minimum": 1,
      "title": "Votes",
      "type": "integer"
    },
    "quorum": {
      "minimum": 2,
      "title": "Quorum",
      "type": "integer"
    },
    "via": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Answered with a signed link sent by slack, teams or email",
      "title": "Via"
    }
  },
  "required": [
    "approval",
    "by",
    "votes",
    "quorum"
  ],
  "title": "approval.voted v1 payload",
  "type": "object"
}
