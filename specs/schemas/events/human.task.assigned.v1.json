{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/human.task.assigned/1",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Work for people: a capability they provide, as agents provide theirs (FR-HUM-08).",
  "properties": {
    "task": {
      "description": "The task.requested event this is the work of",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "title": "Task",
      "type": "string"
    },
    "capability": {
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){0,15}$",
      "title": "Capability",
      "type": "string"
    },
    "assignees": {
      "description": "Principals, role:<name> or group:<name>: any one of them",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Assignees",
      "type": "array"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "output_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "A JSON Schema the answer must match",
      "title": "Output Schema"
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "item": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item"
    }
  },
  "required": [
    "task",
    "capability",
    "assignees"
  ],
  "title": "human.task.assigned v1 payload",
  "type": "object"
}
