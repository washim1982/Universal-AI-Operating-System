{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/model.call.completed/1",
  "$defs": {
    "JsonValue": {},
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "description": "The whole prompt, cached or not.",
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "description": "Prompt tokens a provider served from its cache.",
          "minimum": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "description": "Prompt tokens written to a provider's cache.",
          "minimum": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "call": {
      "description": "Index of the call within the task execution.",
      "minimum": 0,
      "title": "Call",
      "type": "integer"
    },
    "site": {
      "description": "Call-site key (aios.core.ports.CallSite.key).",
      "title": "Site",
      "type": "string"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Routing hint the policy resolved.",
      "title": "Task"
    },
    "operation": {
      "default": "generate",
      "enum": [
        "generate",
        "embed"
      ],
      "title": "Operation",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "stop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "output_text": {
      "description": "The recorded completion (ADR-010), for replay. Empty for embeddings.",
      "title": "Output Text",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/JsonValue",
      "default": null,
      "description": "Parsed structured output, or the size of an embedding (never its vectors)."
    },
    "fallback_from": {
      "description": "Candidates that failed before this one.",
      "items": {
        "type": "string"
      },
      "title": "Fallback From",
      "type": "array"
    },
    "downgraded": {
      "default": false,
      "description": "A soft budget limit chose this model.",
      "title": "Downgraded",
      "type": "boolean"
    },
    "replayed": {
      "default": false,
      "description": "Answered from a recorded run: nothing called, nothing spent",
      "title": "Replayed",
      "type": "boolean"
    },
    "request_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What was asked, so a replay can tell when it asks otherwise",
      "title": "Request Hash"
    }
  },
  "required": [
    "call",
    "site",
    "agent",
    "provider",
    "model",
    "usage",
    "latency_ms",
    "output_text"
  ],
  "title": "model.call.completed v1 payload",
  "type": "object"
}
