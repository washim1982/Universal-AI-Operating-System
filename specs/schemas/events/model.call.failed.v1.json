{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/model.call.failed/1",
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable machine-readable code, e.g. tool.timeout.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "call": {
      "minimum": 0,
      "title": "Call",
      "type": "integer"
    },
    "site": {
      "title": "Site",
      "type": "string"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step"
    },
    "task": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task"
    },
    "error": {
      "$ref": "#/$defs/ErrorInfo"
    },
    "candidates": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Candidates",
      "type": "array"
    }
  },
  "required": [
    "call",
    "site",
    "agent",
    "error"
  ],
  "title": "model.call.failed v1 payload",
  "type": "object"
}
