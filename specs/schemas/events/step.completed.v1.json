{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/step.completed/1",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "copied_from": {
      "anyOf": [
        {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Not run here: the result is the one this run recorded",
      "title": "Copied From"
    },
    "taint": {
      "description": "The untrusted content a copied result came from",
      "items": {
        "type": "string"
      },
      "title": "Taint",
      "type": "array"
    },
    "step": {
      "title": "Step",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "loop": {
      "default": 0,
      "minimum": 0,
      "title": "Loop",
      "type": "integer"
    },
    "looped": {
      "default": false,
      "description": "The result sent the run back to an earlier step (onResult).",
      "title": "Looped",
      "type": "boolean"
    },
    "loops_exhausted": {
      "default": false,
      "title": "Loops Exhausted",
      "type": "boolean"
    },
    "signal": {
      "anyOf": [
        {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The signal a wait step took.",
      "title": "Signal"
    }
  },
  "required": [
    "step"
  ],
  "title": "step.completed v1 payload",
  "type": "object"
}
