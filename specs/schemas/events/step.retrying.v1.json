{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/step.retrying/1",
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable machine-readable code, e.g. tool.timeout.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "step": {
      "title": "Step",
      "type": "string"
    },
    "attempt": {
      "description": "The attempt about to start.",
      "minimum": 2,
      "title": "Attempt",
      "type": "integer"
    },
    "error": {
      "$ref": "#/$defs/ErrorInfo"
    }
  },
  "required": [
    "step",
    "attempt",
    "error"
  ],
  "title": "step.retrying v1 payload",
  "type": "object"
}
