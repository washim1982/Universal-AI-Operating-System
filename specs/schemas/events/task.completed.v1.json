{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/task.completed/1",
  "$defs": {
    "JsonValue": {},
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "description": "The whole prompt, cached or not.",
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "description": "Prompt tokens a provider served from its cache.",
          "minimum": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "description": "Prompt tokens written to a provider's cache.",
          "minimum": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability": {
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){0,15}$",
      "title": "Capability",
      "type": "string"
    },
    "output": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "capability"
  ],
  "title": "task.completed v1 payload",
  "type": "object"
}
