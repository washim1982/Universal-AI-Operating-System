{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/task.failed/1",
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "Stable machine-readable code, e.g. tool.timeout.",
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability": {
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){0,15}$",
      "title": "Capability",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ErrorInfo"
    }
  },
  "required": [
    "capability",
    "error"
  ],
  "title": "task.failed v1 payload",
  "type": "object"
}
