{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/task.requested/1",
  "$defs": {
    "JsonValue": {},
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "title": "TaskBudget",
      "type": "object"
    },
    "TaskSource": {
      "additionalProperties": false,
      "description": "Where a replayed, forked or retried task's run came from, as the components need it.",
      "properties": {
        "run": {
          "description": "The run whose record answers this task's calls",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "title": "Run",
          "type": "string"
        },
        "mode": {
          "enum": [
            "replay",
            "fork",
            "retry"
          ],
          "title": "Mode",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A registry entry every call must use",
          "title": "Model"
        },
        "live": {
          "default": false,
          "description": "Side effects happen for real. Off, they are stubbed.",
          "title": "Live",
          "type": "boolean"
        }
      },
      "required": [
        "run",
        "mode"
      ],
      "title": "TaskSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability": {
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){0,15}$",
      "title": "Capability",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Workflow step id, when the task belongs to a run.",
      "title": "Step"
    },
    "item": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fan-out item index (FR-WF-03).",
      "title": "Item"
    },
    "loop": {
      "default": 0,
      "description": "Loop iteration of the step.",
      "minimum": 0,
      "title": "Loop",
      "type": "integer"
    },
    "attempt": {
      "default": 1,
      "description": "Attempt number of the step.",
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "resumes": {
      "description": "Earlier executions of this task, each stopped to wait for an approval.",
      "items": {
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "type": "string"
      },
      "title": "Resumes",
      "type": "array"
    },
    "taint": {
      "description": "Where the run's untrusted content came from.",
      "items": {
        "type": "string"
      },
      "title": "Taint",
      "type": "array"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set in a replay, fork or retry (FR-OBS-04, FR-WF-11)."
    }
  },
  "required": [
    "capability"
  ],
  "title": "task.requested v1 payload",
  "type": "object"
}
