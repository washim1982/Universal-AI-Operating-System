{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/task.requested/1",
  "$defs": {
    "JsonValue": {},
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Steps"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "timeout_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout S"
        }
      },
      "title": "TaskBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability": {
      "maxLength": 255,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){0,15}$",
      "title": "Capability",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "step": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Workflow step id, when the task belongs to a run.",
      "title": "Step"
    },
    "item": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Fan-out item index (FR-WF-03).",
      "title": "Item"
    },
    "loop": {
      "default": 0,
      "description": "Loop iteration of the step.",
      "minimum": 0,
      "title": "Loop",
      "type": "integer"
    },
    "attempt": {
      "default": 1,
      "description": "Attempt number of the step.",
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "capability"
  ],
  "title": "task.requested v1 payload",
  "type": "object"
}
