{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/tool.call.completed/1",
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "call": {
      "minimum": 0,
      "title": "Call",
      "type": "integer"
    },
    "site": {
      "title": "Site",
      "type": "string"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "number"
    },
    "output": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "untrusted": {
      "default": true,
      "title": "Untrusted",
      "type": "boolean"
    },
    "stubbed": {
      "default": false,
      "description": "Not run: a replay or fork held the side effect back",
      "title": "Stubbed",
      "type": "boolean"
    },
    "replayed": {
      "default": false,
      "description": "Answered from a recorded run",
      "title": "Replayed",
      "type": "boolean"
    }
  },
  "required": [
    "call",
    "site",
    "tool",
    "provider",
    "latency_ms"
  ],
  "title": "tool.call.completed v1 payload",
  "type": "object"
}
