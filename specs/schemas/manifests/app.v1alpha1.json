{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://schemas/manifests/app/v1alpha1",
  "$defs": {
    "AppBudgets": {
      "additionalProperties": false,
      "properties": {
        "perRunUSD": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perrunusd"
        },
        "monthlyUSD": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthlyusd"
        }
      },
      "title": "AppBudgets",
      "type": "object"
    },
    "AppConfig": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema"
        },
        "secrets": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        }
      },
      "title": "AppConfig",
      "type": "object"
    },
    "AppEvaluation": {
      "additionalProperties": false,
      "properties": {
        "online": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnlineEvaluation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "AppEvaluation",
      "type": "object"
    },
    "AppMemory": {
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "default": [],
          "items": {
            "enum": [
              "working",
              "session",
              "user",
              "agent",
              "app",
              "tenant",
              "global"
            ],
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "knowledge": {
          "default": [],
          "items": {
            "$ref": "#/$defs/KnowledgeSource"
          },
          "title": "Knowledge",
          "type": "array"
        }
      },
      "title": "AppMemory",
      "type": "object"
    },
    "AppSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "entrypoints": {
          "items": {
            "discriminator": {
              "mapping": {
                "chat": "#/$defs/ChatEntrypoint",
                "event": "#/$defs/EventEntrypoint",
                "schedule": "#/$defs/ScheduleEntrypoint",
                "webhook": "#/$defs/WebhookEntrypoint"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ChatEntrypoint"
              },
              {
                "$ref": "#/$defs/EventEntrypoint"
              },
              {
                "$ref": "#/$defs/ScheduleEntrypoint"
              },
              {
                "$ref": "#/$defs/WebhookEntrypoint"
              }
            ]
          },
          "minItems": 1,
          "title": "Entrypoints",
          "type": "array"
        },
        "agents": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          },
          "title": "Agents",
          "type": "array"
        },
        "workflows": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          },
          "title": "Workflows",
          "type": "array"
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolRef"
          },
          "title": "Tools",
          "type": "array"
        },
        "memory": {
          "$ref": "#/$defs/AppMemory"
        },
        "permissions": {
          "$ref": "#/$defs/Permissions"
        },
        "egress": {
          "$ref": "#/$defs/Egress"
        },
        "policies": {
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
            "type": "string"
          },
          "title": "Policies",
          "type": "array"
        },
        "modelPolicy": {
          "default": "default",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Modelpolicy",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/AppConfig"
        },
        "budgets": {
          "$ref": "#/$defs/AppBudgets"
        },
        "evaluation": {
          "$ref": "#/$defs/AppEvaluation"
        },
        "humans": {
          "description": "Capabilities people provide",
          "items": {
            "$ref": "#/$defs/HumanCapability"
          },
          "title": "Humans",
          "type": "array"
        }
      },
      "required": [
        "entrypoints"
      ],
      "title": "AppSpec",
      "type": "object"
    },
    "ChatEntrypoint": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "chat",
          "title": "Type",
          "type": "string"
        },
        "workflow": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Workflow",
          "type": "string"
        },
        "untrustedInput": {
          "default": false,
          "description": "Callers pass on someone else's words, e.g. a public chat widget",
          "title": "Untrustedinput",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "workflow"
      ],
      "title": "ChatEntrypoint",
      "type": "object"
    },
    "ContainsGrader": {
      "additionalProperties": false,
      "description": "Passes when the output's text contains ``value``.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
          "title": "Path"
        },
        "weight": {
          "default": 1.0,
          "description": "Its share of the case's score",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "type": {
          "const": "contains",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "ignoreCase": {
          "default": true,
          "title": "Ignorecase",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "value"
      ],
      "title": "ContainsGrader",
      "type": "object"
    },
    "DataClass": {
      "description": "Data classification labels, least to most sensitive (FR-SEC-11).",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "DataClass",
      "type": "string"
    },
    "Egress": {
      "additionalProperties": false,
      "description": "Where this App's tools may send data (FR-SEC-10). Without ``allow``, no App list applies.",
      "properties": {
        "allow": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow"
        },
        "tools": {
          "patternProperties": {
            "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){2}$": {
              "items": {
                "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "title": "Tools",
          "type": "object"
        }
      },
      "title": "Egress",
      "type": "object"
    },
    "EventEntrypoint": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "event",
          "title": "Type",
          "type": "string"
        },
        "on": {
          "maxLength": 255,
          "pattern": "^(?:(?:[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?|\\*)\\.){0,15}(?:[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?|\\*|>)$",
          "title": "On",
          "type": "string"
        },
        "workflow": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Workflow",
          "type": "string"
        },
        "untrustedInput": {
          "default": true,
          "description": "Events usually carry what someone outside wrote, e.g. a ticket",
          "title": "Untrustedinput",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "on",
        "workflow"
      ],
      "title": "EventEntrypoint",
      "type": "object"
    },
    "ExactGrader": {
      "additionalProperties": false,
      "description": "Passes when the output equals ``value``, or the case's ``expected`` when there is none.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
          "title": "Path"
        },
        "weight": {
          "default": 1.0,
          "description": "Its share of the case's score",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "type": {
          "const": "exact",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ExactGrader",
      "type": "object"
    },
    "GroundedGrader": {
      "additionalProperties": false,
      "description": "The share of the answer's sentences that what the run read supports.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
          "title": "Path"
        },
        "weight": {
          "default": 1.0,
          "description": "Its share of the case's score",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "type": {
          "const": "grounded",
          "title": "Type",
          "type": "string"
        },
        "passAt": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Passat",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "GroundedGrader",
      "type": "object"
    },
    "HumanCapability": {
      "additionalProperties": false,
      "description": "People who provide a capability (FR-HUM-08). A workflow step asks for it as it would ask an\nagent, and the work reaches any one of the assignees, who answer it in the console or CLI.",
      "properties": {
        "capability": {
          "maxLength": 255,
          "pattern": "^[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?){0,15}$",
          "title": "Capability",
          "type": "string"
        },
        "assignees": {
          "description": "Principals, role:<name> or group:<name>: any one of them",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Assignees",
          "type": "array"
        },
        "description": {
          "default": "",
          "description": "What to do, as the assignees will read it",
          "title": "Description",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A JSON Schema the answer must match",
          "title": "Output"
        }
      },
      "required": [
        "capability",
        "assignees"
      ],
      "title": "HumanCapability",
      "type": "object"
    },
    "HumanGrader": {
      "additionalProperties": false,
      "description": "A person grades the case, later. The experiment waits for them.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
          "title": "Path"
        },
        "weight": {
          "default": 1.0,
          "description": "Its share of the case's score",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "type": {
          "const": "human",
          "title": "Type",
          "type": "string"
        },
        "reviewers": {
          "items": {
            "pattern": "^(role|user|group):[A-Za-z0-9._@-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reviewers",
          "type": "array"
        },
        "question": {
          "default": "",
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "reviewers"
      ],
      "title": "HumanGrader",
      "type": "object"
    },
    "JsonValue": {},
    "JudgeGrader": {
      "additionalProperties": false,
      "description": "A model scores the output against a rubric, from 0 to 10. Its call is governed like any.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
          "title": "Path"
        },
        "weight": {
          "default": 1.0,
          "description": "Its share of the case's score",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "type": {
          "const": "judge",
          "title": "Type",
          "type": "string"
        },
        "rubric": {
          "minLength": 1,
          "title": "Rubric",
          "type": "string"
        },
        "task": {
          "default": "evaluation",
          "description": "Routing hint for the model policy",
          "title": "Task",
          "type": "string"
        },
        "passAt": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Passat",
          "type": "number"
        }
      },
      "required": [
        "name",
        "type",
        "rubric"
      ],
      "title": "JudgeGrader",
      "type": "object"
    },
    "KnowledgeSource": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "scope": {
          "default": "app",
          "enum": [
            "working",
            "session",
            "user",
            "agent",
            "app",
            "tenant",
            "global"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "KnowledgeSource",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "title": "Version",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "OnlineEvaluation": {
      "additionalProperties": false,
      "description": "Grade a sample of production runs as they finish. Nobody's answer is known, so only\ngraders that need none: schema, contains, regex, exact with a value, judge and grounded.",
      "properties": {
        "sample": {
          "description": "The share of runs graded",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Sample",
          "type": "number"
        },
        "graders": {
          "items": {
            "discriminator": {
              "mapping": {
                "contains": "#/$defs/ContainsGrader",
                "exact": "#/$defs/ExactGrader",
                "grounded": "#/$defs/GroundedGrader",
                "human": "#/$defs/HumanGrader",
                "judge": "#/$defs/JudgeGrader",
                "regex": "#/$defs/RegexGrader",
                "schema": "#/$defs/SchemaGrader"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ExactGrader"
              },
              {
                "$ref": "#/$defs/ContainsGrader"
              },
              {
                "$ref": "#/$defs/RegexGrader"
              },
              {
                "$ref": "#/$defs/SchemaGrader"
              },
              {
                "$ref": "#/$defs/JudgeGrader"
              },
              {
                "$ref": "#/$defs/GroundedGrader"
              },
              {
                "$ref": "#/$defs/HumanGrader"
              }
            ]
          },
          "minItems": 1,
          "title": "Graders",
          "type": "array"
        }
      },
      "required": [
        "sample",
        "graders"
      ],
      "title": "OnlineEvaluation",
      "type": "object"
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "What the App asks a tenant admin to consent to at install time (FR-APP-03).",
      "properties": {
        "tools": {
          "items": {
            "pattern": "^(?:(?:[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?|\\*)\\.){0,15}(?:[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?|\\*|>)$",
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "dataClasses": {
          "items": {
            "$ref": "#/$defs/DataClass"
          },
          "title": "Dataclasses",
          "type": "array"
        }
      },
      "title": "Permissions",
      "type": "object"
    },
    "RegexGrader": {
      "additionalProperties": false,
      "description": "Passes when the output's text matches ``pattern`` somewhere.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
          "title": "Path"
        },
        "weight": {
          "default": 1.0,
          "description": "Its share of the case's score",
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "type": {
          "const": "regex",
          "title": "Type",
          "type": "string"
        },
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "pattern"
      ],
      "title": "RegexGrader",
      "type": "object"
    },
    "ScheduleEntrypoint": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "schedule",
          "title": "Type",
          "type": "string"
        },
        "cron": {
          "description": "minute hour day month weekday, in UTC",
          "title": "Cron",
          "type": "string"
        },
        "workflow": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Workflow",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        }
      },
      "required": [
        "type",
        "cron",
        "workflow"
      ],
      "title": "ScheduleEntrypoint",
      "type": "object"
    },
    "SchemaGrader": {
      "additionalProperties": false,
      "description": "Passes when the output is valid against a JSON Schema.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]+(\\.[A-Za-z0-9_-]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where in the run's output to look; all of it if left out",
